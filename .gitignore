# SPDX-License-Identifier: Apache-2.0
# Runtime secrets and local state — never commit.
.env
*.env
.env.bak-*
.env.new-*
!.env.example

# Key material must NEVER be committed. The signing key lives only in the
# running proxy's memory (pushed over its ingest socket), never on disk here.
secrets/
*.key
*.pem

# Build / runtime scratch.
venv/
.make/
__pycache__/
*.pyc

# Editor / OS artefacts.
.DS_Store
*.swp
*~

# generated proxy config dir (from make init)
config/

# monitoring data (MONITORING_DATA_DIR default)
/data/

# bits-admin's passkeys and encrypted passphrases (sudo make admin-install)
/admin-data/

# the site's profile, as bits-admin saves it, and its backups
/site-profile.yaml
/site-profile.yaml.bak-*
/site-profile.yaml.new-*
