# SPDX-License-Identifier: Apache-2.0
# bits-services configuration template. Run `make init` to generate .env with
# sensible defaults and prompts — do not hand-edit this example.
#
# NO secrets belong here. The signing key is NEVER stored in .env or baked into an
# image — it is pushed into the running proxy over its ingest socket and held only
# in memory. The sign-proxy URL/token are written by `make unlock`.

# ─── security-proxy ──────────────────────────────────────────────────────────
# Host dir with the proxy's config.json (a copy of security-proxy/config.sample.json),
# mounted read-only. `make init` creates and populates it.
SECURITY_PROXY_CONFIG_DIR=

# ─── bits-console backend ────────────────────────────────────────────────────
# Path to your LOCAL bits checkout (console-backend/ + bits_helpers/).
BITS_SRC=../bits

# Host dir holding the backend's TLS cert.pem + key.pem. `make init` generates a
# self-signed pair here if absent (fine when a CERN front re-encrypts to the
# backend; for a browser-facing backend, replace with a browser-trusted cert).
TLS_CERT_DIR=

# Signing proxy — written by `make unlock` once the proxy is up (they change on a
# proxy restart; re-run `make unlock` then).
BITS_SIGN_PROXY_URL=
# BITS_SIGN_PROXY_TOKEN=      (written by make unlock; never commit)

# Identity + CORS.
GITLAB_API_URL=https://gitlab.cern.ch/api/v4
BITS_FRONTEND_ORIGIN=https://bits-console.web.cern.ch

# Who may sign (ADMINS format; overall admin = `* @user`). Put yourself here and
# keep it aligned with the community's bits_admins in ui-config.yaml.
BITS_ADMINS_POLICY=
# BITS_ADMIN_RESOLVE_TOKEN=   (read-only service token, only if you use &group refs)

# WebAuthn — the FRONTEND host (the passkey ceremony runs on the Pages page).
BITS_WEBAUTHN_RP_ID=bits-console.web.cern.ch
BITS_WEBAUTHN_ORIGIN=https://bits-console.web.cern.ch
BITS_WEBAUTHN_CREDENTIALS=/data/creds.json
BITS_WEBAUTHN_REQUIRE_UV=1
BITS_ENROLLMENT_AUTHORITY=1
BITS_WEBAUTHN_REQUIRED=0

# CI identity (optional — for automated signing later).
BITS_OIDC_ISSUER=
BITS_OIDC_CI_AUDIENCE=
BITS_OIDC_JWKS_URL=
BITS_CI_SIGNERS=
