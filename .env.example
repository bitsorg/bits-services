# SPDX-License-Identifier: Apache-2.0
# bits-services configuration template. Copy to .env and fill in.
#
# NO secrets belong in .env.example. The signing key is NEVER stored here or
# baked into any image — it is pushed into the running proxy over its ingest
# socket and held only in memory.

# ─── security-proxy (Phase 1) ────────────────────────────────────────────────
# Host directory with the proxy's root-owned config (mounted read-only).
SECURITY_PROXY_CONFIG_DIR=
# Host directory for the 0600 ingest / gate-token sockets.
SECURITY_PROXY_SOCKET_DIR=
# Pinned ali-bot commit the proxy image is built from (Phase 1a).
ALIBOT_REF=

# ─── bits-console backend (Phase 3) ──────────────────────────────────────────
# GitLab OIDC confidential-client id (the client SECRET goes in .env, not here).
# BITS_CONSOLE_OIDC_CLIENT_ID=
# Public front origin served via web.cern.ch reverse-proxy.
# BITS_CONSOLE_PUBLIC_ORIGIN=

# ─── monitoring (Phase 4) ────────────────────────────────────────────────────
# (filled when the stack is extracted from cvmfs-testbed)
