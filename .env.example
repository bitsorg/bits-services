# SPDX-License-Identifier: Apache-2.0
# bits-services configuration template. Run `make init` to generate .env with
# sensible defaults and prompts — do not hand-edit this example.
#
# NO secrets belong here. The signing key is NEVER stored in .env or baked into an
# image — it is pushed into the running proxy over its ingest socket and held only
# in memory. The sign-proxy URL/token are written by `make unlock`.

# ─── security-proxy ──────────────────────────────────────────────────────────
# Host dir with the proxy's config.json (a copy of security-proxy/config.sample.json),
# mounted read-only. `make init` creates and populates it.
SECURITY_PROXY_CONFIG_DIR=

# ─── bits-console backend ────────────────────────────────────────────────────
# Path to your LOCAL bits checkout (console-backend/ + bits_helpers/).
BITS_SRC=../bits

# Host dir holding the backend's TLS cert.pem + key.pem. `make init` generates a
# self-signed pair here if absent (fine when a CERN front re-encrypts to the
# backend; for a browser-facing backend, replace with a browser-trusted cert).
TLS_CERT_DIR=

# Signing proxy — written by `make unlock` once the proxy is up (they change on a
# proxy restart; re-run `make unlock` then).
BITS_SIGN_PROXY_URL=
# BITS_SIGN_PROXY_TOKEN=      (written by make unlock; never commit)

# Identity + CORS. The cross-device (CLI/QR) approve link is built from this origin
# plus the community the caller passes (?community=<name>) — not configured here,
# since the backend serves many communities.
GITLAB_API_URL=https://gitlab.cern.ch/api/v4
BITS_FRONTEND_ORIGIN=https://bits-console.web.cern.ch

# Who may sign (ADMINS format; overall admin = `* @user`). Put yourself here and
# keep it aligned with the community's bits_admins in ui-config.yaml.
BITS_ADMINS_POLICY=

# Catalog read cache (/gh proxy). The console's package/recipe reads go through the
# backend so they use ONE authenticated GitHub token (5000/hr) + a TTL cache instead
# of each browser's unauthenticated 60/hr per IP.
#   TOKEN MUST BE PUBLIC-READ (a no-scope classic token, or a fine-grained token with
#   only public read): the /gh proxy is unauthenticated to callers, so a token that
#   can read PRIVATE repos would expose them. Never put a repo-scoped PAT here.
# The proxy is already locked to the console's read shapes (repo meta / trees / blobs
# / tags / branches) under /repos/*. OWNERS is an OPTIONAL extra narrowing to specific
# GitHub owners; leave empty to allow any owner (recipe providers resolve to arbitrary
# owners, so an allowlist can block legitimate providers). TTL in seconds.
BITS_GITHUB_TOKEN=
BITS_CATALOG_OWNERS=
BITS_CATALOG_TTL=300

# Ops proxy (Phase 1): the backend triggers builds on the caller's behalf using an
# api-scope PROJECT access token (role Maintainer, so it can also cancel/retry/delete
# later) on the shared build project. NOT a pipeline trigger token (those only
# trigger). It lives here in the backend env for now; custody moves into the
# security-proxy in a later increment. BITS_FORGE_PROJECT is that project's numeric
# id (or url-encoded path). The caller never sees this token.
BITS_FORGE_OPS_TOKEN=
BITS_FORGE_PROJECT=
# Refs the ops endpoint may build (comma-separated). Pinned so a community admin
# can't trigger an arbitrary ref whose CI could reach another community. Default: main.
BITS_FORGE_REFS=main
# BITS_ADMIN_RESOLVE_TOKEN=   (read-only service token, only if you use &group refs)

# WebAuthn. rp_id is a shared PARENT domain (e.g. cern.ch) so ONE passkey works on
# both the Pages frontend (enrolment) AND this backend's own approve page (cross-
# device approval, no SSO). List every origin the ceremony runs on — the frontend
# AND the backend host — in BITS_WEBAUTHN_ORIGINS; all are accepted at verification.
BITS_WEBAUTHN_RP_ID=cern.ch
BITS_WEBAUTHN_ORIGIN=https://bits-console.web.cern.ch
BITS_WEBAUTHN_ORIGINS=https://bits-console.web.cern.ch,https://bits.cern.ch
BITS_WEBAUTHN_CREDENTIALS=/data/creds.json
BITS_WEBAUTHN_REQUIRE_UV=1
BITS_ENROLLMENT_AUTHORITY=1
BITS_WEBAUTHN_REQUIRED=0

# CI identity (OIDC) — REQUIRED for the build/publish signing chain: the certify job
# authenticates with a GitLab ID token instead of holding a key. BITS_OIDC_CI_AUDIENCE
# must equal the bits-manifests BITS_SIGN_SERVICE_URL byte-for-byte (no trailing slash).
BITS_OIDC_ISSUER=https://gitlab.cern.ch
BITS_OIDC_JWKS_URL=https://gitlab.cern.ch/oauth/discovery/keys
BITS_OIDC_CI_AUDIENCE=https://bits.cern.ch

# Phase 2: the backend is a GitLab OIDC client and issues its OWN session (browser
# holds no GitLab token). Register a CONFIDENTIAL GitLab OAuth app for the BACKEND:
#   Redirect URI: https://bits.cern.ch/auth/callback   (= BITS_OIDC_LOGIN_REDIRECT)
#   Scopes: openid (+ email profile). Confidential (has a secret; NOT the Pages
#   public client). Its Application ID/Secret go below.
BITS_OIDC_LOGIN_CLIENT_ID=
BITS_OIDC_LOGIN_CLIENT_SECRET=
BITS_OIDC_LOGIN_REDIRECT=https://bits.cern.ch/auth/callback
BITS_OIDC_AUTHORIZE_URL=https://gitlab.cern.ch/oauth/authorize
BITS_OIDC_TOKEN_URL=https://gitlab.cern.ch/oauth/token
BITS_SESSION_TTL=43200
# Frontend origin(s) we may hand a fresh session back to after login (open-redirect
# guard). Comma-separated.
BITS_LOGIN_RETURN_ALLOW=https://bits-console.web.cern.ch
BITS_CI_SIGNERS=
